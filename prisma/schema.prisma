generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Define Investment Model
model Investment {
  id                 String    @id @default(cuid())
  name               String    // Nama aset investasi (misal: Saham Bank BCA, Bitcoin)
  type               String    // Jenis investasi: STOCK, CRYPTO, MUTUAL_FUND, PROPERTY, OTHER
  tickerSymbol       String?   // Simbol ticker (misal: BBCA, BTC-USD)
  quantity           Float     // Jumlah unit/lembar yang dimiliki
  averagePurchasePrice Float     // Harga beli rata-rata per unit
  purchaseDate       DateTime  // Tanggal pembelian awal atau rata-rata
  notes              String?   // Catatan tambahan
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relasi ke User
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  
  // Relasi ke Wallet (NEW)
  wallet             Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId           String

  @@index([userId])
  @@index([walletId]) // NEW INDEX
}

model User {
  id                   String                 @id @default(cuid())
  name                 String?
  email                String                 @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  riskProfile          String?                // Profil risiko investasi: Konservatif, Moderat, Agresif
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  accounts             Account[]
  budgets              Budget[]
  categories           Category[]
  sessions             Session[]
  transactions         Transaction[]
  settings             UserSettings?
  wallets              Wallet[]
  goals                Goal[]
  categoryRules        CategoryRule[]
  RecurringTransaction RecurringTransaction[]
  investments          Investment[]
  
  // Group budget feature relations
  ownedGroups          Group[]               @relation("OwnedGroups")
  groupMemberships     UserGroup[]
  groupTransactions    GroupTransaction[]
  expenseSplits        ExpenseSplit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id                    String                  @id @default(cuid())
  name                  String
  balance               Float                   @default(0)
  currencyCode          String                  @default("IDR")
  icon                  String?
  color                 String?
  isDefault             Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  userId                String
  budgets               Budget[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  investments           Investment[]
}

model Category {
  id            String         @id @default(cuid())
  name          String
  type          String
  icon          String?
  color         String?
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  budgets       Budget[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  parentId      String? // For sub-categories
  categoryRules CategoryRule[]
  
  // Group budget feature relations
  groupBudgets       GroupBudget[]
  groupTransactions  GroupTransaction[]

  @@unique([name, userId])
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String?
  date        DateTime
  type        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  walletId    String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String   @id @default(cuid())
  amount     Float
  spent      Float    @default(0)
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  walletId   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyFund {
  id        String   @id @default(cuid())
  target    Float
  current   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  currency      String   @default("IDR")
  language      String   @default("id")
  theme         String   @default("light")
  provider      String?
  apiKey        String?
  selectedModel String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  target      Float
  current     Float    @default(0)
  startDate   DateTime @default(now())
  targetDate  DateTime
  type        String // e.g., "EMERGENCY_FUND", "HOME_DOWN_PAYMENT", "EDUCATION", etc.
  description String?
  icon        String?
  color       String?
  status      String   @default("ONGOING") // "ONGOING", "COMPLETED", "CANCELLED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CategoryRule {
  id         String   @id @default(cuid())
  name       String
  pattern    String
  isRegex    Boolean  @default(false)
  isActive   Boolean  @default(true)
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id              String   @id @default(cuid())
  name            String
  amount          Float
  category        String?
  frequency       String // "Daily", "Weekly", "Monthly", "Yearly" 
  startDate       DateTime
  nextPaymentDate DateTime
  description     String?
  isActive        Boolean  @default(true)
  type            String   @default("expense") // "income" or "expense"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  walletId        String
  userId          String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ====== GROUP BUDGET FEATURE MODELS ======

// Main group model
model Group {
  id          String       @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?      @default("#6366f1") // Default color: Indigo
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ownerId     String
  owner       User         @relation("OwnedGroups", fields: [ownerId], references: [id])
  members     UserGroup[]
  wallets     GroupWallet[]
  budgets     GroupBudget[]
  invites     GroupInvite[]
}

// Group membership model
model UserGroup {
  id          String    @id @default(cuid())
  userId      String
  groupId     String
  role        String    @default("MEMBER") // Values: "OWNER", "ADMIN", "MEMBER"
  permissions String?   // Flexible permissions (stored as JSON)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  group       Group     @relation(fields: [groupId], references: [id])
  
  @@unique([userId, groupId])
}

// Group wallet model
model GroupWallet {
  id           String             @id @default(cuid())
  groupId      String
  name         String
  balance      Float              @default(0)
  currencyCode String             @default("IDR")
  icon         String?
  color        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  group        Group              @relation(fields: [groupId], references: [id])
  transactions GroupTransaction[]
}

// Group transaction model
model GroupTransaction {
  id             String           @id @default(cuid())
  groupWalletId  String
  amount         Float
  type           String           // INCOME, EXPENSE, TRANSFER
  date           DateTime
  description    String?
  notes          String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  groupWallet    GroupWallet      @relation(fields: [groupWalletId], references: [id])
  splits         ExpenseSplit[]
}

// Expense split model - for tracking how expenses are split among users
model ExpenseSplit {
  id                 String           @id @default(cuid())
  groupTransactionId String
  transaction        GroupTransaction @relation(fields: [groupTransactionId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  amount             Float            // Amount this user is responsible for
  isPaid             Boolean          @default(false)
  paidDate           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([groupTransactionId, userId])
}

// Group budget model
model GroupBudget {
  id          String    @id @default(cuid())
  groupId     String
  name        String
  amount      Float
  spent       Float     @default(0)
  startDate   DateTime
  endDate     DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group     @relation(fields: [groupId], references: [id])
}

// Group invite model
model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email     String?
  code      String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  usedById  String?
}

// ====== END GROUP BUDGET MODELS ======

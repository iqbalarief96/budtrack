# Google Cloud Vision API Configuration
# 
# Option 1: Use environment variable (recommended for production)
# Set this to the path of your Google Cloud service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-vision-credentials.json

# Option 2: Store credentials path in database (via Settings UI)
# Users can configure this in the app's Settings page
# The path will be stored in UserSettings.googleVisionCredentials

# Example paths:
# Linux/Mac: /home/user/budtrack/credentials/google-vision.json
# Windows: C:\budtrack\credentials\google-vision.json
# Docker: /app/credentials/google-vision.json

# Note: Make sure the file has proper read permissions
# chmod 600 /path/to/google-vision-credentials.json

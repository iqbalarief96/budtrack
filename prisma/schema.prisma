generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Investment {
  id                   String   @id @default(cuid())
  name                 String
  type                 String
  tickerSymbol         String?
  quantity             Float
  averagePurchasePrice Float
  purchaseDate         DateTime
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  walletId             String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet               Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  riskProfile             String?
  dashboardLayout         String?
  accounts                Account[]
  alerts                  Alert[]
  budgets                 Budget[]
  budgetAlerts            BudgetAlert[]
  categories              Category[]
  categoryRules           CategoryRule[]
  chatMessages            ChatMessage[]
  dashboardViews          DashboardView[]
  emergencyFund           EmergencyFund?
  expenseSplits           ExpenseSplit[]
  financialAdvice         FinancialAdvice[]
  goals                   Goal[]
  goalActivities          GoalActivity[]
  ownedGroups             Group[]                  @relation("OwnedGroups")
  groupTransactions       GroupTransaction[]
  investments             Investment[]
  RecurringTransaction    RecurringTransaction[]
  sessions                Session[]
  transactions            Transaction[]
  importRecords           ImportRecord[]
  receiptAttachments       ReceiptAttachment[]
  groupMemberships        UserGroup[]
  groupSettings           UserGroupSettings[]
  settings                UserSettings?
  wallets                 Wallet[]
  walletEmergencyFunds    WalletEmergencyFund[]
  weddings                Wedding[]
  debts                   Debt[]
  salaryAllocationConfigs SalaryAllocationConfig[]
  bills                   Bill[]
  billReminders           BillReminder[]
  creditCards             CreditCard[]
  creditCardTransactions  CreditCardTransaction[]
  goalProjections         GoalProjection[]
  goalPriorities          GoalPriority[]
  timelineScenarios       TimelineScenario[]
  savingRateHistory       SavingRateHistory[]
  netWorthSnapshots       NetWorthSnapshot[]
  netWorthGoals           NetWorthGoal[]
  spendingInsights        SpendingInsight[]
  spendingAlerts          SpendingAlert[]
  spendingStats           SpendingStats[]
  walletGroups            WalletGroup[]
  subscriptionTrackers    SubscriptionTracker[]
  sharedBills             SharedBill[]
  sharedBillParticipants  SharedBillParticipant[]
  savingsRules            SavingsRule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id                    String                 @id @default(cuid())
  name                  String
  balance               Float                  @default(0)
  currencyCode          String                 @default("IDR")
  icon                  String?
  color                 String?
  isDefault             Boolean                @default(false)
  type                  String                 @default("MAIN") // MAIN, SAVINGS, INVESTMENT
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userId                String
  budgets               Budget[]
  emergencyFund         WalletEmergencyFund?
  investments           Investment[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills                 Bill[]
  walletGroupMembers    WalletGroupMember[]
  subscriptionTrackers  SubscriptionTracker[]
  sharedBills           SharedBill[]
  creditCards           CreditCard[]
  importRecords         ImportRecord[]
  savingsRules          SavingsRule[]

  @@index([userId])
  @@index([userId, type])
  @@index([isDefault])
}

model Category {
  id                String             @id @default(cuid())
  name              String
  type              String
  icon              String?
  color             String?
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            String
  parentId          String?
  budgets           Budget[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRules     CategoryRule[]
  goalCategories    GoalCategory[]
  groupBudgets      GroupBudget[]
  groupTransactions GroupTransaction[]
  transactions      Transaction[]
  allocationItems   AllocationItem[]
  bills             Bill[]
  spendingInsights  SpendingInsight[]
  spendingAlerts    SpendingAlert[]
  spendingStats     SpendingStats[]

  @@unique([name, userId])
}

model Transaction {
  id               String                        @id @default(cuid())
  amount           Float
  description      String?
  date             DateTime
  type             String
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  userId           String
  walletId         String
  categoryId       String?
  goalId           String?
  importRecordId   String?
  migrationSourceTransactionId String?
  migrationBatchId String?
  transferPairId String?
  goalActivities   GoalActivity[]
  recurringHistory RecurringTransactionHistory[]
  items            TransactionItem[]
  category         Category?                     @relation(fields: [categoryId], references: [id])
  goal             Goal?                         @relation(fields: [goalId], references: [id])
  importRecord     ImportRecord?                 @relation(fields: [importRecordId], references: [id], onDelete: SetNull)
  receiptAttachments ReceiptAttachment[]
  migrationSourceTransaction   Transaction?  @relation("SavingsMigrationSource", fields: [migrationSourceTransactionId], references: [id], onDelete: SetNull)
  migratedTransactions         Transaction[] @relation("SavingsMigrationSource")
  wallet           Wallet                        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([walletId, type])
  @@index([walletId, date])
  @@index([categoryId])
  @@index([importRecordId])
  @@index([migrationSourceTransactionId])
  @@index([userId, migrationBatchId])
  @@index([userId, transferPairId])
  @@index([userId, type, categoryId])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  name          String
  quantity      Float       @default(1)
  unitPrice     Float
  totalPrice    Float
  category      String?
  notes         String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([name])
}

model ReceiptAttachment {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  fileName      String
  mimeType      String
  size          Int
  source        String      @default("manual_upload")
  storageUrl    String?
  extractedText String?
  metadata      String?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([transactionId])
}

model ImportRecord {
  id            String        @id @default(cuid())
  userId        String
  walletId      String
  source        String        @default("bank_csv")
  fileName      String?
  rowHash       String
  rawRow        String
  parsedDate    DateTime
  parsedAmount  Float
  parsedType    String
  status        String        @default("IMPORTED") // IMPORTED, DUPLICATE, ERROR
  errorMessage  String?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, walletId, rowHash])
  @@index([userId, createdAt])
  @@index([walletId])
}

model Budget {
  id                     String          @id @default(cuid())
  amount                 Float
  spent                  Float           @default(0)
  startDate              DateTime
  endDate                DateTime
  periodType             String          @default("MONTHLY") // MONTHLY, WEEKLY, DAILY, QUARTERLY, YEARLY
  isRecurring            Boolean         @default(false)
  lastResetDate          DateTime?
  notificationThresholds String? // JSON string: {"warning": 80, "critical": 100}
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  userId                 String
  walletId               String
  categoryId             String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                 Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category               Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  history                BudgetHistory[]
  alerts                 BudgetAlert[]

  @@index([userId])
  @@index([walletId])
  @@index([categoryId])
  @@index([endDate])
}

model BudgetHistory {
  id          String   @id @default(cuid())
  budgetId    String
  amount      Float
  spent       Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([periodStart])
}

model BudgetAlert {
  id           String   @id @default(cuid())
  budgetId     String
  userId       String
  alertType    String // WARNING (80%), CRITICAL (100%), EXCEEDED (120%)
  threshold    Float
  currentSpent Float
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  budget       Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model EmergencyFund {
  id                  String   @id @default(cuid())
  userId              String   @unique
  targetAmount        Float
  currentAmount       Float
  monthlyContribution Float
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  currency                String   @default("IDR")
  language                String   @default("id")
  theme                   String   @default("light")
  colorTheme              String   @default("blue")
  provider                String?
  apiKey                  String?
  openaiApiKey            String?
  geminiApiKey            String?
  googleVisionCredentials String?
  customEndpoint          String?
  selectedModel           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialAdvice {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  priority        String
  estimatedImpact Float?
  walletId        String?
  timeframe       String
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model SavingsRule {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  pattern             String
  isRegex             Boolean  @default(false)
  isActive            Boolean  @default(true)
  destinationWalletId String
  priority            Int      @default(100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationWallet   Wallet   @relation(fields: [destinationWalletId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, priority])
  @@index([destinationWalletId])
}

model CategoryRule {
  id         String   @id @default(cuid())
  name       String
  pattern    String
  isRegex    Boolean  @default(false)
  isActive   Boolean  @default(true)
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id              String                        @id @default(cuid())
  name            String
  amount          Float
  category        String?
  frequency       String
  startDate       DateTime
  nextPaymentDate DateTime
  description     String?
  isActive        Boolean                       @default(true)
  type            String                        @default("expense")
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  walletId        String
  userId          String
  wallet          Wallet                        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  history         RecurringTransactionHistory[]
  bills           Bill[]
}

model RecurringTransactionHistory {
  id                     String               @id @default(cuid())
  recurringTransactionId String
  transactionId          String?
  processedDate          DateTime             @default(now())
  targetDate             DateTime
  amount                 Float
  status                 String               @default("CREATED")
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  transaction            Transaction?         @relation(fields: [transactionId], references: [id])
  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)

  @@index([recurringTransactionId])
  @@index([transactionId])
}

// ============================================================================
// SISTEM GRUP #1 — COLLABORATIVE / MULTI-USER  (model Group dst di bawah ini)
// ----------------------------------------------------------------------------
// Dipakai untuk berbagi anggaran ANTAR-USER (mis. keluarga/tim): ada members,
// roles, invites, dan wallet milik grup sendiri (GroupWallet).
// API: app/api/groups/**   UI: menu "Group Budget" (Sidebar) / route /groups
// Status: AKTIF (GROUP_FEATURE_ENABLED = true di app/api/groups/*).
//
// JANGAN ketuker dengan SISTEM GRUP #2 (WalletGroup) di bawah — itu untuk
// satu user yang menggabung wallet-nya sendiri, BUKAN kolaborasi antar-user.
// ============================================================================
model Group {
  id           String              @id @default(cuid())
  name         String
  description  String?
  icon         String?
  color        String?             @default("#6366f1")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  ownerId      String
  isPrivate    Boolean             @default(false)
  owner        User                @relation("OwnedGroups", fields: [ownerId], references: [id])
  budgets      GroupBudget[]
  invites      GroupInvite[]
  wallets      GroupWallet[]
  members      UserGroup[]
  userSettings UserGroupSettings[]
}

model UserGroup {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  role        String   @default("MEMBER")
  permissions String?
  joinedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model UserGroupSettings {
  id                 String   @id @default(cuid())
  userId             String
  groupId            String
  notificationMethod String   @default("email")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model GroupWallet {
  id           String             @id @default(cuid())
  groupId      String
  name         String
  balance      Float              @default(0)
  currencyCode String             @default("IDR")
  icon         String?
  color        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions GroupTransaction[]
  group        Group              @relation(fields: [groupId], references: [id])
}

model GroupTransaction {
  id            String         @id @default(cuid())
  groupWalletId String
  amount        Float
  type          String
  date          DateTime
  description   String?
  notes         String?
  createdById   String
  categoryId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  splits        ExpenseSplit[]
  createdBy     User           @relation(fields: [createdById], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  groupWallet   GroupWallet    @relation(fields: [groupWalletId], references: [id])
}

model ExpenseSplit {
  id                 String           @id @default(cuid())
  groupTransactionId String
  userId             String
  amount             Float
  isPaid             Boolean          @default(false)
  paidDate           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  transaction        GroupTransaction @relation(fields: [groupTransactionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id])

  @@unique([groupTransactionId, userId])
}

model GroupBudget {
  id         String    @id @default(cuid())
  groupId    String
  name       String
  amount     Float
  spent      Float     @default(0)
  startDate  DateTime
  endDate    DateTime
  categoryId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category? @relation(fields: [categoryId], references: [id])
  group      Group     @relation(fields: [groupId], references: [id])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  email     String?
  code      String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  createdBy String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  usedById  String?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id               String   @id @default(cuid())
  userId           String
  userMessage      String
  assistantMessage String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id             String   @id @default(cuid())
  userId         String
  type           String
  title          String
  message        String
  additionalData String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id             String           @id @default(cuid())
  userId         String
  name           String
  target         Float
  current        Float            @default(0)
  deadline       DateTime?
  category       String?
  description    String?
  icon           String?
  color          String?
  status         String           @default("ONGOING")
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities     GoalActivity[]
  goalCategories GoalCategory[]
  transactions   Transaction[]
  projections    GoalProjection[]
  priority       GoalPriority?

  @@index([userId])
}

model GoalActivity {
  id            String       @id @default(cuid())
  goalId        String
  amount        Float
  date          DateTime     @default(now())
  description   String?
  createdAt     DateTime     @default(now())
  userId        String
  transactionId String?
  goal          Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([transactionId])
  @@index([userId])
}

model DashboardView {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  timeframe String?
  widgets   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wedding {
  id               String                  @id @default(cuid())
  userId           String
  title            String
  date             DateTime
  location         String?
  budget           Float                   @default(0)
  spentBudget      Float                   @default(0)
  expectedGuests   Int                     @default(0)
  status           String                  @default("PLANNING")
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  documents        Document[]
  gifts            Gift[]
  moodboardItems   Moodboard[]
  playlists        Playlist[]
  rundownItems     Rundown[]
  souvenirs        Souvenir[]
  vendors          Vendor[]
  venues           Venue[]
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategories WeddingBudgetCategory[]
  guests           WeddingGuest[]

  @@index([userId])
}

model WeddingBudgetCategory {
  id        String              @id @default(cuid())
  weddingId String
  name      String
  total     Float               @default(0)
  spent     Float               @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  wedding   Wedding             @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  items     WeddingBudgetItem[]

  @@index([weddingId])
}

model WeddingBudgetItem {
  id         String                @id @default(cuid())
  categoryId String
  name       String
  budgeted   Float
  actual     Float                 @default(0)
  paid       Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  category   WeddingBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Venue {
  id            String    @id @default(cuid())
  weddingId     String
  name          String
  address       String
  capacity      Int?
  priceRange    String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  notes         String?
  isBooked      Boolean   @default(false)
  bookingDate   DateTime?
  depositAmount Float?
  imageUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  features      String?
  wedding       Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Vendor {
  id              String   @id @default(cuid())
  weddingId       String
  name            String
  category        String
  description     String?
  contactPerson   String?
  phone           String?
  email           String?
  website         String?
  address         String?
  priceRange      String?
  status          String   @default("pending")
  rating          Float?
  imageUrl        String?
  instagramHandle String?
  notes           String?
  features        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Document {
  id            String    @id @default(cuid())
  weddingId     String
  name          String
  description   String?
  deadline      DateTime?
  location      String?
  status        String    @default("NOT_STARTED")
  isMandatory   Boolean   @default(false)
  notes         String?
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  wedding       Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Rundown {
  id          String   @id @default(cuid())
  weddingId   String
  title       String
  startTime   DateTime
  endTime     DateTime
  description String?
  location    String?
  responsible String?
  category    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Souvenir {
  id                String    @id @default(cuid())
  weddingId         String
  name              String
  type              String?
  quantity          Int
  pricePerUnit      Float
  totalBudget       Float
  actualCostPerUnit Float     @default(0)
  totalActualCost   Float     @default(0)
  vendor            String?
  description       String?
  imageUrl          String?
  status            String    @default("PLANNING")
  orderDate         DateTime?
  deliveryDate      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  wedding           Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Playlist {
  id         String   @id @default(cuid())
  weddingId  String
  title      String
  artist     String
  duration   String?
  category   String?
  url        String?
  notes      String?
  order      Int?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Moodboard {
  id            String   @id @default(cuid())
  weddingId     String
  title         String
  description   String?
  imageUrl      String
  category      String?
  isInspiration Boolean  @default(true)
  isApproved    Boolean  @default(false)
  source        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          String?
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Gift {
  id            String   @id @default(cuid())
  weddingId     String
  name          String
  quantity      Int      @default(1)
  estimatedCost Float    @default(0)
  actualCost    Float    @default(0)
  status        String   @default("not-started")
  responsible   String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model WeddingGuest {
  id                  String   @id @default(cuid())
  weddingId           String
  name                String
  relationship        String?
  contactNumber       String?
  email               String?
  address             String?
  confirmed           Boolean  @default(false)
  attended            Boolean  @default(false)
  group               String?
  seats               Int      @default(1)
  dietaryRestrictions String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  wedding             Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model WalletEmergencyFund {
  id           String   @id @default(cuid())
  walletId     String   @unique
  targetAmount Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
}

model GoalCategory {
  id         String   @id @default(cuid())
  goalId     String
  categoryId String
  createdAt  DateTime @default(now())
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([goalId, categoryId])
  @@index([goalId])
  @@index([categoryId])
}

model Debt {
  id             String        @id @default(cuid())
  userId         String
  name           String
  type           String // CREDIT_CARD, PERSONAL_LOAN, MORTGAGE, STUDENT_LOAN, AUTO_LOAN, OTHER
  originalAmount Float
  currentBalance Float
  interestRate   Float // Annual percentage rate
  minimumPayment Float
  dueDay         Int? // Day of month payment is due
  startDate      DateTime
  isActive       Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       DebtPayment[]

  @@index([userId])
  @@index([isActive])
}

model SalaryAllocationConfig {
  id            String           @id @default(cuid())
  userId        String
  name          String
  monthlyIncome Float
  templateType  String // '50-30-20', '70-20-10', 'custom'
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         AllocationItem[]

  @@index([userId])
}

model AllocationItem {
  id               String                 @id @default(cuid())
  configId         String
  categoryName     String
  categoryType     String // 'needs', 'wants', 'savings'
  percentage       Float
  amount           Float
  mappedCategoryId String?
  icon             String?
  color            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  config           SalaryAllocationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  mappedCategory   Category?              @relation(fields: [mappedCategoryId], references: [id])

  @@index([configId])
  @@index([mappedCategoryId])
}

model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  amount        Float
  paymentDate   DateTime
  principalPaid Float
  interestPaid  Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  debt          Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paymentDate])
}

model Bill {
  id                     String    @id @default(cuid())
  userId                 String
  name                   String
  amount                 Float
  dueDate                DateTime
  categoryId             String?
  walletId               String
  recurringTransactionId String?
  reminderDays           String    @default("[1, 3, 7]") // JSON array
  notes                  String?
  isRecurring            Boolean   @default(false)
  frequency              String? // DAILY, WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, YEARLY
  isPaid                 Boolean   @default(false)
  paidDate               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id])
  wallet               Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])
  payments             BillPayment[]
  reminders            BillReminder[]

  @@index([userId])
  @@index([dueDate])
  @@index([isPaid])
  @@index([recurringTransactionId])
}

model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  amount    Float
  paidDate  DateTime
  dueDate   DateTime // Original due date for this payment
  daysEarly Int // Positive = early, negative = late
  notes     String?
  createdAt DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([paidDate])
}

model BillReminder {
  id           String    @id @default(cuid())
  billId       String
  userId       String
  reminderDate DateTime
  daysBefore   Int
  status       String    @default("PENDING") // PENDING, SENT, DISMISSED, SNOOZED
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([userId])
  @@index([reminderDate])
  @@index([status])
}

model CreditCard {
  id                  String                  @id @default(cuid())
  userId              String
  walletId            String?
  name                String
  issuer              String?
  lastFour            String?
  creditLimit         Float                   @default(0)
  currentBalance      Float                   @default(0)
  statementDay        Int
  dueDay              Int
  apr                 Float?
  minimumPaymentRate  Float                   @default(0.03)
  reminderDaysBefore  Int                     @default(7)
  status              String                  @default("active") // active, paused, closed
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?                 @relation(fields: [walletId], references: [id], onDelete: SetNull)
  transactions CreditCardTransaction[]

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@map("credit_cards")
}

model CreditCardTransaction {
  id          String     @id @default(cuid())
  userId      String
  cardId      String
  amount      Float
  type        String     @default("charge") // charge, payment, fee, adjustment
  description String?
  merchant    String?
  category    String?
  date        DateTime   @default(now())
  statementId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
  @@index([date])
  @@index([type])
  @@map("credit_card_transactions")
}

// Financial Goals Timeline Models

model GoalProjection {
  id                 String   @id @default(cuid())
  goalId             String
  userId             String
  projectedDate      DateTime
  confidenceLevel    String // 'low', 'medium', 'high'
  requiredSavingRate Float
  currentProgress    Float
  assumptions        String // JSON string for assumptions
  createdAt          DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@map("goal_projections")
}

model GoalPriority {
  id        String   @id @default(cuid())
  userId    String
  goalId    String   @unique
  priority  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId])
  @@index([userId])
  @@index([goalId])
  @@map("goal_priorities")
}

model TimelineScenario {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  assumptions String // JSON string for scenario assumptions
  projections String // JSON string for scenario projections
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("timeline_scenarios")
}

model SavingRateHistory {
  id         String   @id @default(cuid())
  userId     String
  month      DateTime
  income     Float
  expenses   Float
  savings    Float
  savingRate Float
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("saving_rate_history")
}

// Net Worth Tracker Models

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime
  totalAssets      Float
  totalLiabilities Float
  netWorth         Float
  breakdown        String // JSON string for breakdown data
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("net_worth_snapshots")
}

model NetWorthGoal {
  id           String   @id @default(cuid())
  userId       String
  targetAmount Float
  targetDate   DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("net_worth_goals")
}

// Spending Insights & Anomaly Alerts Models

model SpendingInsight {
  id          String   @id @default(cuid())
  userId      String
  type        String // 'spending_increase', 'spending_decrease', 'absence', 'transaction_size', 'weekend_pattern'
  categoryId  String?
  title       String
  description String
  severity    String // 'low', 'medium', 'high'
  data        String // JSON string for additional data
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([isRead])
  @@index([isDismissed])
  @@map("spending_insights")
}

model SpendingAlert {
  id         String   @id @default(cuid())
  userId     String
  type       String // 'category_limit', 'daily_limit', 'anomaly'
  categoryId String?
  threshold  Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([isActive])
  @@map("spending_alerts")
}

model SpendingStats {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  period     String // 'daily', 'weekly', 'monthly'
  date       DateTime
  amount     Float
  count      Int
  avgAmount  Float
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, period, date])
  @@index([userId])
  @@index([categoryId])
  @@index([date])
  @@map("spending_stats")
}

// ============================================================================
// SISTEM GRUP #2 — PERSONAL WALLET LINKING  (single-user)
// ----------------------------------------------------------------------------
// Dipakai SATU user untuk menggabung beberapa wallet MILIKNYA SENDIRI jadi
// satu tampilan agregat (mis. lihat Dompet Utama + Selly sekaligus). TIDAK ada
// members/invites/roles — murni view gabungan. Maks 5 grup per user.
// API: app/api/wallet-groups/**   UI: "Wallet Groups" di WalletSelector
// Service agregasi: lib/wallet-group/*.
//
// JANGAN ketuker dengan SISTEM GRUP #1 (Group) di atas — itu kolaborasi
// antar-user dengan wallet milik grup, beda total dari penggabungan ini.
// ============================================================================
model WalletGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallets     WalletGroupMember[]
  sharedBills SharedBill[]

  @@index([userId])
  @@map("wallet_groups")
}

model WalletGroupMember {
  id            String   @id @default(cuid())
  walletGroupId String
  walletId      String
  addedAt       DateTime @default(now())

  walletGroup WalletGroup @relation(fields: [walletGroupId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletGroupId, walletId])
  @@index([walletGroupId])
  @@index([walletId])
  @@map("wallet_group_members")
}

model SubscriptionTracker {
  id                 String    @id @default(cuid())
  userId             String
  walletId           String?
  name               String
  provider           String?
  description        String?
  category           String    @default("other")
  amount             Float     @default(0)
  currencyCode       String    @default("IDR")
  billingCycle       String    @default("monthly") // monthly, yearly, weekly, quarterly, one_time, trial_only
  status             String    @default("active") // trial, active, paused, cancelled, expired
  startDate          DateTime?
  trialEndsAt        DateTime?
  nextBillingAt      DateTime?
  cancelBeforeAt     DateTime?
  reminderDaysBefore Int       @default(3)
  autoRenew          Boolean   @default(true)
  reminderEnabled    Boolean   @default(true)
  website            String?
  notes              String?
  lastReminderSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([nextBillingAt])
  @@map("subscription_trackers")
}

model SharedBill {
  id              String                  @id @default(cuid())
  userId          String
  walletId        String?
  walletGroupId   String?
  title           String
  description     String?
  category        String                  @default("household")
  totalAmount     Float                   @default(0)
  currencyCode    String                  @default("IDR")
  dueDate         DateTime?
  paidAt          DateTime?
  status          String                  @default("open") // open, partially_paid, paid, cancelled
  ownership       String                  @default("SHARED") // HIS, HERS, SHARED
  splitMethod     String                  @default("equal") // equal, fixed, percentage
  recurrence      String                  @default("none") // none, weekly, monthly, yearly
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet?                 @relation(fields: [walletId], references: [id], onDelete: SetNull)
  walletGroup     WalletGroup?            @relation(fields: [walletGroupId], references: [id], onDelete: SetNull)
  participants    SharedBillParticipant[]

  @@index([userId])
  @@index([walletId])
  @@index([walletGroupId])
  @@index([status])
  @@index([ownership])
  @@index([dueDate])
  @@map("shared_bills")
}

model SharedBillParticipant {
  id             String     @id @default(cuid())
  sharedBillId   String
  userId         String?
  name           String
  email          String?
  shareAmount    Float      @default(0)
  sharePercent   Float?
  paidAmount     Float      @default(0)
  status         String     @default("unpaid") // unpaid, partial, paid, waived
  ownerRole      String     @default("SHARED") // HIS, HERS, SHARED
  paidAt         DateTime?
  settlementNote String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sharedBill     SharedBill @relation(fields: [sharedBillId], references: [id], onDelete: Cascade)
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sharedBillId])
  @@index([userId])
  @@index([status])
  @@index([ownerRole])
  @@map("shared_bill_participants")
}
